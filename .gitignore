/logs
*.log
# Runtime caches — never commit; they may contain API payloads with sensitive identifiers.
/cache/voice_ai_reports/
/cache/voice_ai_insights/
/cache/rate_limit/
/cache/**/*.json
# Logo reescalado en base64 para el PDF de liquidacion: se regenera solo a
# partir de assets/logo.png la primera vez que hace falta.
/cache/logo_pdf_*.txt
# Clave de cifrado de la boveda de credenciales de acceso remoto.
# NUNCA subir: si se filtra se pueden descifrar las contrasenas; si se borra se pierden.
/config/vault_key.php
# Credenciales de BD por servidor (HostGator usa 'localhost', la oficina la IP).
# Se mantiene fuera del repo para que "git pull" nunca choque con db.php.
/config/db_local.php
# Adjuntos de tickets subidos por usuarios (compat; los nuevos van en la DB compartida).
/uploads/helpdesk/
# Config local de Claude Code (preview/launch): rutas absolutas por maquina, no va al repo.
/.claude/
